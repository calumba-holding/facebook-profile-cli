{
  "name": "facebook-profile-cli",
  "version": "0.1.0",
  "description": "CLI to scrape Facebook profiles (posts, photos, tabs) with a signed-in Chrome session",
  "repository": {
    "type": "git",
    "url": "https://github.com/calumba-holding/facebook-profile-cli.git"
  },
  "homepage": "https://github.com/calumba-holding/facebook-profile-cli",
  "type": "module",
  "bin": {
    "facebook": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -rf dist/scrape/browser && mkdir -p dist/scrape/browser && cp -R src/scrape/browser/. dist/scrape/browser/",
    "dev": "npm run build --silent && node dist/cli.js",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "playwright": "1.58.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "license": "ISC"
}
